<Window x:Class="MultiRoblox.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check for update" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" Icon="/Assets/app.ico">
    <StackPanel Margin="20">
        <TextBlock x:Name="Headline" Style="{StaticResource H1}"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Installed" Style="{StaticResource Subtle}" Margin="0,0,16,4"/>
            <TextBlock x:Name="CurrentText" Grid.Column="1" Margin="0,0,0,4"/>
            <TextBlock Text="Latest" Style="{StaticResource Subtle}" Grid.Row="1" Margin="0,0,16,0"/>
            <TextBlock x:Name="LatestText" Grid.Row="1" Grid.Column="1"/>
        </Grid>

        <Border x:Name="NotesBox" Background="{DynamicResource Surface}" CornerRadius="6" Padding="10"
                Margin="0,14,0,0" Visibility="Collapsed" MaxHeight="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Style="{StaticResource Subtle}"/>
            </ScrollViewer>
        </Border>

        <ProgressBar x:Name="Progress" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1"
                     Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface2}"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Subtle}" Margin="0,8,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="YesButton" Content="Update now" Style="{StaticResource AccentButton}"
                    Click="Yes_Click" Visibility="Collapsed"/>
            <Button x:Name="NoButton" Content="Close" Margin="8,0,0,0" Click="No_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
