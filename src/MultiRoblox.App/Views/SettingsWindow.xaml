<Window x:Class="MultiRoblox.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="560" Width="560" MinHeight="300" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" Icon="/Assets/app.ico">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Hyperlink NavigateUri="https://github.com/triumvirite/MultiRoblox"
                           RequestNavigate="Repo_RequestNavigate"
                           Foreground="{DynamicResource LinkText}" TextDecorations="Underline">
                    GitHub repository
                </Hyperlink>
            </TextBlock>
            <TextBlock Grid.Column="1" x:Name="VersionText" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Style="{StaticResource Subtle}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click" Width="90"/>
                <Button Content="Cancel" Margin="8,0,0,0" Click="Cancel_Click" Width="90"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="Appearance" Style="{StaticResource H1}"/>
            <ComboBox x:Name="ThemeBox" Width="200" HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <TextBlock Text="Accounts" Style="{StaticResource H1}" Margin="0,20,0,0"/>
            <CheckBox x:Name="DoubleClickQJ" Margin="0,8,0,0"
                      Content="Double-click a selected account to Quick Join on it"/>

            <TextBlock Text="Multi-instance" Style="{StaticResource H1}" Margin="0,20,0,0"/>
            <CheckBox x:Name="MultiInstance" Content="Allow multiple Roblox clients at once" Margin="0,8,0,0"/>
            <TextBlock Text="Held via the Roblox singleton objects while the app runs." Style="{StaticResource Subtle}" Margin="0,2,0,0"/>

            <TextBlock Text="RobloxPlayerBeta.exe path (optional)" Margin="0,16,0,4" Style="{StaticResource Subtle}"/>
            <TextBox x:Name="RobloxPath"/>

            <TextBlock Text="Sessions" Style="{StaticResource H1}" Margin="0,20,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Keep-alive every" VerticalAlignment="Center"/>
                <TextBox x:Name="RefreshMinutes" Width="60" Margin="8,0"/>
                <TextBlock Text="minutes (0 = off)" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="AutoRelaunch" Content="Auto-relaunch an instance if it disconnects" Margin="0,8,0,0"/>
            <CheckBox x:Name="CloseToTray" Content="Closing the window minimises to the tray" Margin="0,8,0,0"/>

            <TextBlock Text="Local control API" Style="{StaticResource H1}" Margin="0,20,0,0"/>
            <CheckBox x:Name="ApiEnabled" Content="Enable HTTP API on 127.0.0.1" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Port" VerticalAlignment="Center"/>
                <TextBox x:Name="ApiPort" Width="80" Margin="8,0"/>
                <TextBlock Text="Key" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox x:Name="ApiKey" Width="200" Margin="8,0"/>
            </StackPanel>

            <TextBlock Text="Frame rate" Style="{StaticResource H1}" Margin="0,20,0,0"/>
            <CheckBox x:Name="FpsEnabled" Content="Override Roblox's frame-rate cap" Margin="0,8,0,0"
                      Checked="FpsEnabled_Changed" Unchecked="FpsEnabled_Changed"/>
            <StackPanel x:Name="FpsRow" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Cap at" VerticalAlignment="Center"/>
                <TextBox x:Name="FpsTarget" Width="70" Margin="8,0"/>
                <TextBlock Text="FPS  (0 = uncapped)" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Off leaves Roblox's own cap untouched. Applied to ClientAppSettings.json on launch."
                       Style="{StaticResource Subtle}" Margin="0,2,0,0"/>

            <TextBlock Text="Data" Style="{StaticResource H1}" Margin="0,20,0,0"/>
            <TextBlock x:Name="DataPathText" Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Open data folder location" Click="OpenDataFolder_Click"/>
                <Button Content="Open logs" Margin="8,0,0,0" Click="OpenLogs_Click"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
