<Window x:Class="MultiRoblox.App.Views.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Add account" Height="620" Width="820" WindowStartupLocation="CenterOwner">
    <Grid Margin="0">
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Margin="8">
            <TabItem Header="Log in">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" Padding="12,8" CornerRadius="6" Margin="0,4,0,8">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Subtle}"
                                   Text="Sign in to the account below (2FA and captcha are handled here). When the login completes, MultiRoblox captures the session cookie automatically — your password is never seen or stored."/>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock x:Name="LoginStatus" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Subtle}"/>
                        <Button Content="Reset" Click="ResetWebView_Click"/>
                        <Button Content="Cancel" Margin="8,0,0,0" Click="Cancel_Click"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                        <wv2:WebView2 x:Name="Web"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Paste cookie">
                <StackPanel Margin="4">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Subtle}" Margin="0,4,0,8"
                               Text="Paste a .ROBLOSECURITY value (with or without the warning prefix). You can also paste the whole cookie header."/>
                    <TextBox x:Name="CookieBox" AcceptsReturn="True" Height="260" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock x:Name="PasteStatus" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Subtle}"/>
                        <Button Content="Validate &amp; add" Style="{StaticResource AccentButton}" Click="AddPasted_Click"/>
                        <Button Content="Cancel" Margin="8,0,0,0" Click="Cancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
