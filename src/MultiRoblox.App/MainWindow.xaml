<Window x:Class="MultiRoblox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MultiRoblox.App"
        xmlns:vm="clr-namespace:MultiRoblox.App.ViewModels"
        Title="MultiRoblox" Height="640" Width="1000" MinHeight="480" MinWidth="820"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Window.Resources>
        <app:HealthToBrushConverter x:Key="HealthBrush"/>
        <app:BoolToVisibilityConverter x:Key="BoolVis"/>
        <app:NullToBoolConverter x:Key="NotNull"/>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Accounts" Style="{StaticResource H1}"/>
                    <TextBox Grid.Row="1" Margin="0,8,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search"/>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10" HorizontalAlignment="Stretch">
                    <Button Content="Add" Style="{StaticResource AccentButton}" Command="{Binding AddAccountCommand}" Width="70"/>
                    <Button Content="Remove" Command="{Binding RemoveAccountCommand}" Margin="6,0,0,0" Width="70"/>
                    <Button Content="↑" Command="{Binding MoveUpCommand}" Margin="6,0,0,0" Width="30"/>
                    <Button Content="↓" Command="{Binding MoveDownCommand}" Margin="4,0,0,0" Width="30"/>
                </StackPanel>

                <ListBox x:Name="AccountList" Margin="4" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding AccountsView}"
                         SelectedItem="{Binding SelectedAccount}"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="AccountList_PreviewMouseLeftButtonDown"
                         MouseMove="AccountList_MouseMove"
                         Drop="AccountList_Drop"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Subtle}"
                                               Margin="8,10,0,4" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountItemViewModel}">
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{Binding Health, Converter={StaticResource HealthBrush}}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding HealthText}" Style="{StaticResource Subtle}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Main pane -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedAccount.Label, FallbackValue='Select an account'}" Style="{StaticResource H1}"/>
                    </StackPanel>
                    <Button Content="Settings" HorizontalAlignment="Right" Command="{Binding OpenSettingsCommand}"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding Status}" Margin="16,6" Style="{StaticResource Subtle}"/>
            </Border>

            <Grid Background="{DynamicResource Bg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Actions for the selected account -->
                <StackPanel Margin="16" IsEnabled="{Binding SelectedAccount, Converter={StaticResource NotNull}}">
                    <TextBlock Text="Join a game" Style="{StaticResource Subtle}" FontWeight="SemiBold"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding PlaceIdInput, UpdateSourceTrigger=PropertyChanged}" Tag="Place ID"/>
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding JobIdInput, UpdateSourceTrigger=PropertyChanged}" Tag="Job ID (optional)"/>
                        <Button Grid.Column="2" Margin="8,0,0,0" Content="Join" Style="{StaticResource AccentButton}"
                                Command="{Binding JoinCommand}"/>
                        <Button Grid.Column="3" Margin="8,0,0,0" Content="Servers…" Command="{Binding OpenServerBrowserCommand}"/>
                    </Grid>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Refresh session" Command="{Binding RefreshAccountCommand}" Margin="0,0,8,8"/>
                        <Button Content="Utilities" Command="{Binding OpenUtilitiesCommand}" Margin="0,0,8,8"/>
                        <Button Content="Open in browser" Command="{Binding OpenInBrowserCommand}" Margin="0,0,8,8"/>
                        <Button Content="Copy cookie" Command="{Binding CopyCookieCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Running instances -->
                <DockPanel Grid.Row="1" Margin="16,0,16,16">
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="Running instances" Style="{StaticResource Subtle}" FontWeight="SemiBold"/>
                        <Button Content="Close all" HorizontalAlignment="Right" Style="{StaticResource DangerButton}"
                                Command="{Binding TerminateAllCommand}" Padding="10,4"/>
                    </Grid>
                    <ListView Margin="0,8,0,0" ItemsSource="{Binding Instances}" Background="{DynamicResource Surface}"
                              BorderBrush="{DynamicResource Border}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Account" Width="220" DisplayMemberBinding="{Binding AccountLabel}"/>
                                <GridViewColumn Header="Where" Width="260" DisplayMemberBinding="{Binding Where}"/>
                                <GridViewColumn Header="State" Width="110" DisplayMemberBinding="{Binding StateText}"/>
                                <GridViewColumn Header="" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Leave" Style="{StaticResource DangerButton}" Padding="8,3"
                                                    Command="{Binding DataContext.LeaveInstanceCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
