<Window x:Class="MultiRoblox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:MultiRoblox.App"
        xmlns:vm="clr-namespace:MultiRoblox.App.ViewModels"
        Title="MultiRoblox" Height="640" Width="1000" MinHeight="480" MinWidth="820"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Window.Resources>
        <app:HealthToBrushConverter x:Key="HealthBrush"/>
        <app:AccountStatusToBrushConverter x:Key="StatusBrush"/>
        <app:BoolToVisibilityConverter x:Key="BoolVis"/>
        <app:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True"/>
        <app:NullToBoolConverter x:Key="NotNull"/>
        <app:UpdateStatusToBrushConverter x:Key="UpdateBrush"/>
        <app:EqualsToVisibilityConverter x:Key="EqVis"/>
        <app:StringToVisibilityConverter x:Key="NotEmptyVis"/>
        <app:RelativeTimeConverter x:Key="Ago"/>

        <!-- join-mode toggle buttons: accent fill when their mode is active -->
        <Style x:Key="ModeManual" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding JoinModeValue}" Value="Manual">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeFavorites" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding JoinModeValue}" Value="Favorites">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeRecents" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding JoinModeValue}" Value="Recents">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeFinder" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding JoinModeValue}" Value="PlayerFinder">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                    <TextBlock Text="Accounts" Style="{StaticResource H1}"/>
                    <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}" VerticalAlignment="Center">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Static vm:MainViewModel.NewCategoryItem}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                        <Setter Property="Padding" Value="8,8"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SubtleText}"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBox Margin="0,8,0,0" Tag="Search"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Margin="2,8,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleText}">
                        <Run Text="Quick Join: "/><Run Text="{Binding QuickJoinValueText, Mode=OneWay}">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasQuickJoin}" Value="False">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run>
                    </TextBlock>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding QuickJoinButtonText}"
                                Command="{Binding QuickJoinCommand}" Margin="0,0,3,0"
                                ToolTip="Launch the selected account into your Quick Join game">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllTargetsInQuickJoinGame}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1" Content="Clear" Style="{StaticResource DangerButton}" Padding="4,0"
                                Command="{Binding ClearQuickJoinCommand}" Margin="3,0,0,0"
                                ToolTip="Clear Quick Join"/>
                    </Grid>
                </StackPanel>

                <Grid DockPanel.Dock="Bottom" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Add" Style="{StaticResource AccentButton}"
                            Command="{Binding AddAccountCommand}" Margin="0,0,3,0"/>
                    <Button Grid.Column="1" Content="Import" Command="{Binding ImportAccountsCommand}" Margin="3,0,3,0"
                            ToolTip="Import accounts from Roblox Account Manager's AccountData.json"/>
                    <Button Grid.Column="2" Content="Remove" Style="{StaticResource DangerButton}"
                            Command="{Binding RemoveAccountCommand}" Margin="3,0,0,0"/>
                </Grid>

                <ListBox x:Name="AccountList" Margin="4" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding AccountsView}"
                         SelectedItem="{Binding SelectedAccount}"
                         SelectionMode="Extended"
                         SelectionChanged="AccountList_SelectionChanged"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="AccountList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="AccountList_MouseMove"
                         DragOver="AccountList_DragOver"
                         Drop="AccountList_Drop"
                         ContextMenuOpening="AccountList_ContextMenuOpening"
                         MouseDoubleClick="AccountList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountItemViewModel}">
                            <Grid Margin="4,6">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter Property="Opacity" Value="0.35"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <!-- signed-in / not-checked: a coloured dot -->
                                    <Ellipse x:Name="Dot" Width="9" Height="9"
                                             Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}"/>
                                    <!-- in-game: the ingame glyph, tinted green -->
                                    <Rectangle x:Name="InGameIcon" Width="17" Height="17" Visibility="Collapsed" Fill="{DynamicResource Ok}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://application:,,,/Assets/ingame.png"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <!-- needs re-login: a bold ! -->
                                    <TextBlock x:Name="Bang" Text="!" Visibility="Collapsed" FontWeight="Bold" FontSize="20"
                                               Foreground="{DynamicResource Danger}" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="Sub" Text="{Binding StatusText}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleText}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="InGame">
                                    <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource Ok}"/>
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="InGameIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="SignedIn">
                                    <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource Info}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="NeedsLogin">
                                    <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource Danger}"/>
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Bang" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource OnAccentMuted}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Main pane ===================== -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectionSummary, FallbackValue='Select an account'}" Style="{StaticResource H1}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                               ToolTip="{Binding SelectionSummary}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Grid>
                            <Button x:Name="UpdateButton" Click="UpdateButton_Click" ToolTip="{Binding UpdateTooltip}"
                                    AutomationProperties.Name="UpdateToggle">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding UpdateButtonText}" VerticalAlignment="Center"/>
                                    <Ellipse Width="8" Height="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                             Fill="{Binding UpdateState, Converter={StaticResource UpdateBrush}}"/>
                                </StackPanel>
                            </Button>

                            <!-- update dropdown, centred under the button -->
                            <Popup x:Name="UpdatePopup" IsOpen="{Binding UpdatePopupOpen, Mode=TwoWay}" StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=UpdateButton}" Closed="UpdatePopup_Closed"
                                   Placement="Custom" VerticalOffset="6" AllowsTransparency="True">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1" CornerRadius="8" Width="300" Padding="14"
                                        TextElement.Foreground="{DynamicResource Text}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UpdateHeadline}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Text="Installed" Style="{StaticResource Subtle}" Margin="0,0,14,3"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UpdateInstalledText}" Margin="0,0,0,3"
                                                       Foreground="{DynamicResource Text}"/>
                                            <TextBlock Grid.Row="1" Text="Latest" Style="{StaticResource Subtle}" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdateLatestText}"
                                                       Foreground="{DynamicResource Text}"/>
                                        </Grid>
                                        <ProgressBar Height="5" Margin="0,12,0,0" Minimum="0" Maximum="1"
                                                     Value="{Binding UpdateProgress}"
                                                     Visibility="{Binding UpdateInstalling, Converter={StaticResource BoolVis}}"
                                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface2}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                            <Button Content="Update now" Style="{StaticResource AccentButton}"
                                                    Command="{Binding InstallUpdateCommand}"
                                                    IsEnabled="{Binding UpdateCanInstall}"
                                                    Visibility="{Binding UpdateCanInstall, Converter={StaticResource BoolVis}}"/>
                                            <Button Content="Close" Margin="8,0,0,0" Style="{StaticResource DangerButton}"
                                                    Command="{Binding DismissUpdateCommand}"/>
                                        </StackPanel>
                                        <TextBlock Margin="0,10,0,0">
                                            <Hyperlink NavigateUri="https://github.com/triumvirite/MultiRoblox"
                                                       RequestNavigate="Hyperlink_RequestNavigate"
                                                       Foreground="{DynamicResource Accent}" TextDecorations="Underline">
                                                Click here for the GitHub repo
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button Margin="8,0,0,0" Background="{Binding ThemeToggleBackground}"
                                Command="{Binding ToggleThemeCommand}" ToolTip="Switch the app to this theme">
                            <TextBlock Text="{Binding ThemeToggleText}" Foreground="{Binding ThemeToggleForeground}"/>
                        </Button>
                        <Button Content="Settings" Margin="8,0,0,0" Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <Grid Margin="12,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="{Binding AccountViewToggleText}" Command="{Binding ToggleAccountViewCommand}" Padding="10,3"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Subtle}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,4,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <Grid><!-- toggled content area -->

            <!-- ============ Account grid view (Excel-style) ============ -->
            <DockPanel Background="{DynamicResource Bg}" Margin="16"
                       Visibility="{Binding ShowAccountGrid, Converter={StaticResource BoolVis}}">
                <DataGrid x:Name="AccountsGrid" ItemsSource="{Binding AccountGrid}" PreviewMouseWheel="Grid_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="AccountsGrid_CellSingleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Width="180" IsReadOnly="True"
                                            Binding="{Binding Label}"
                                            ElementStyle="{StaticResource GridDisplayText}"/>
                        <DataGridTextColumn Header="Alias" Width="160"
                                            Binding="{Binding Alias}"
                                            ElementStyle="{StaticResource GridDisplayText}"
                                            EditingElementStyle="{StaticResource GridEditText}"/>
                        <DataGridTextColumn Header="Description" Width="300"
                                            Binding="{Binding Note}"
                                            ElementStyle="{StaticResource GridDisplayText}"
                                            EditingElementStyle="{StaticResource GridEditText}"/>
                        <DataGridTemplateColumn Header="Categories" Width="220" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ToggleButton x:Name="CatBtn" Style="{StaticResource FlatToggle}" Focusable="False"
                                                      PreviewMouseDown="CatBtn_PreviewDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding CategoriesText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                      Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource SubtleText}"/>
                                            </Grid>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=CatBtn}" StaysOpen="True"
                                               PlacementTarget="{Binding ElementName=CatBtn}" Placement="Bottom"
                                               AllowsTransparency="True" PopupAnimation="Fade" Closed="CatPopup_Closed">
                                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="1" CornerRadius="6" Padding="6" MinWidth="170" Margin="0,2,0,0">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding CategoryChoices}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" Margin="2,3"
                                                                          IsChecked="{Binding IsMember, Mode=TwoWay}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,5"/>
                                                    <Button Content="Add new category…" HorizontalAlignment="Left"
                                                            Background="Transparent" BorderThickness="0" Padding="2,3"
                                                            Command="{Binding DataContext.AddCategoryToRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Grid Background="{DynamicResource Bg}"
                  Visibility="{Binding ShowAccountGrid, Converter={StaticResource BoolVisInv}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============ Join panel ============ -->
                <StackPanel Margin="16" IsEnabled="{Binding SelectedAccount, Converter={StaticResource NotNull}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Manual" Style="{StaticResource ModeManual}"
                                Command="{Binding SetJoinModeCommand}" CommandParameter="Manual"/>
                        <Button Content="Favorites" Style="{StaticResource ModeFavorites}"
                                Command="{Binding SetJoinModeCommand}" CommandParameter="Favorites"/>
                        <Button Content="Recents" Style="{StaticResource ModeRecents}"
                                Command="{Binding SetJoinModeCommand}" CommandParameter="Recents"/>
                        <Button Content="Player finder" Style="{StaticResource ModeFinder}"
                                Command="{Binding SetJoinModeCommand}" CommandParameter="PlayerFinder"/>
                    </StackPanel>

                    <!-- Manual -->
                    <Grid Margin="0,12,0,0"
                          Visibility="{Binding JoinModeValue, Converter={StaticResource EqVis}, ConverterParameter=Manual}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding PlaceIdInput, UpdateSourceTrigger=PropertyChanged}" Tag="Place ID or game link"/>
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding JobIdInput, UpdateSourceTrigger=PropertyChanged}" Tag="Job ID (optional)"/>
                        <Button Grid.Column="2" Margin="8,0,0,0" Content="★ Favorite" Style="{StaticResource GoldButton}"
                                Command="{Binding AddFavoriteCommand}" ToolTip="Save this place to your favorites"/>
                        <Button Grid.Column="3" Margin="8,0,0,0" Content="{Binding ManualQuickJoinText}"
                                Command="{Binding SetManualQuickJoinCommand}" ToolTip="Make this the Quick Join game"/>
                        <Button Grid.Column="4" Margin="8,0,0,0" Content="Join" Style="{StaticResource AccentButton}" Command="{Binding JoinCommand}"/>
                    </Grid>

                    <!-- resolved game name for the entered Place ID -->
                    <TextBlock Margin="2,10,0,4" MinHeight="18" TextTrimming="CharacterEllipsis"
                               Text="{Binding GameName}" FontWeight="SemiBold" Foreground="{DynamicResource SubtleText}"
                               Visibility="{Binding JoinModeValue, Converter={StaticResource EqVis}, ConverterParameter=Manual}"/>

                    <!-- Favorites -->
                    <DockPanel Margin="0,12,0,0" Height="160"
                               Visibility="{Binding JoinModeValue, Converter={StaticResource EqVis}, ConverterParameter=Favorites}">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Join" Style="{StaticResource AccentButton}" Command="{Binding JoinFavoriteCommand}"/>
                            <Button Content="{Binding FavoriteQuickJoinText}" Margin="8,0,0,0" Command="{Binding SetQuickJoinFromFavoriteCommand}"/>
                            <Button Content="Remove" Margin="8,0,0,0" Style="{StaticResource DangerButton}" Command="{Binding RemoveFavoriteCommand}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Favorites}" SelectedItem="{Binding SelectedFavorite}"
                                 Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                 MouseDoubleClick="Favorite_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock x:Name="Pid" DockPanel.Dock="Right" Text="{Binding PlaceId}" FontSize="12"
                                                   Foreground="{DynamicResource SubtleText}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Padding="2" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Pid" Property="Foreground" Value="{StaticResource OnAccentMuted}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Recents -->
                    <DockPanel Margin="0,12,0,0" Height="160"
                               Visibility="{Binding JoinModeValue, Converter={StaticResource EqVis}, ConverterParameter=Recents}">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Join" Style="{StaticResource AccentButton}" Command="{Binding JoinRecentCommand}"/>
                            <Button Content="{Binding RecentQuickJoinText}" Margin="8,0,0,0" Command="{Binding SetQuickJoinFromRecentCommand}"/>
                            <Button Content="Clear" Margin="8,0,0,0" Style="{StaticResource DangerButton}" Command="{Binding ClearRecentsCommand}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Recents}" SelectedItem="{Binding SelectedRecent}"
                                 Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                 MouseDoubleClick="Recent_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock x:Name="Ago" Text="{Binding LastPlayed, Converter={StaticResource Ago}}"
                                                       FontSize="11" Foreground="{DynamicResource SubtleText}" TextAlignment="Right"/>
                                            <TextBlock x:Name="Pid" Text="{Binding PlaceId}" FontSize="11"
                                                       Foreground="{DynamicResource SubtleText}" TextAlignment="Right"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Padding="2" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Pid" Property="Foreground" Value="{StaticResource OnAccentMuted}"/>
                                            <Setter TargetName="Ago" Property="Foreground" Value="{StaticResource OnAccentMuted}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Player finder -->
                    <DockPanel Margin="0,12,0,0" Height="180"
                               Visibility="{Binding JoinModeValue, Converter={StaticResource EqVis}, ConverterParameter=PlayerFinder}">
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FinderQuery, UpdateSourceTrigger=PropertyChanged}" Tag="usernames or IDs, comma-separated"/>
                            <Button Grid.Column="1" Content="Find" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding FindPlayersCommand}"/>
                        </Grid>
                        <ListBox Margin="0,8,0,0" ItemsSource="{Binding FinderResults}"
                                 Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Join" Padding="8,2"
                                                IsEnabled="{Binding Joinable}"
                                                Command="{Binding DataContext.JoinFoundPlayerCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <!-- Refresh session: hidden — re-login (right-click / double-click a signed-out account) covers it
                        <Button Content="Refresh session" Command="{Binding RefreshAccountCommand}" Margin="0,0,8,8"/>
                        -->
                        <Button Content="Utilities" Command="{Binding OpenUtilitiesCommand}" Margin="0,0,8,8"/>
                        <Button Content="Open in browser" Command="{Binding OpenInBrowserCommand}" Margin="0,0,8,8"/>
                        <!-- Copy cookie: disabled for now
                        <Button Content="Copy cookie" Command="{Binding CopyCookieCommand}" Margin="0,0,8,8"/>
                        -->
                    </WrapPanel>
                </StackPanel>

                <!-- ============ Running instances ============ -->
                <DockPanel Grid.Row="1" Margin="16,0,16,16">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1,1,1,3" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Running instances" Style="{StaticResource Subtle}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="Close all" Style="{StaticResource DangerButton}"
                                    Command="{Binding TerminateAllCommand}" Padding="10,3"/>
                        </Grid>
                    </Border>
                    <DataGrid ItemsSource="{Binding Instances}" IsReadOnly="True" BorderThickness="1,0,1,1"
                              RowHeight="44" PreviewMouseWheel="Grid_PreviewMouseWheel">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Account" Width="200"
                                                Binding="{Binding AccountLabel}"
                                                ElementStyle="{StaticResource GridDisplayText}"/>
                            <DataGridTemplateColumn Header="Where" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlaceLine}"/>
                                            <TextBlock Text="{Binding GameName}" Style="{StaticResource Subtle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding GameName, Converter={StaticResource NotEmptyVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="State" Width="120"
                                                Binding="{Binding StateText}"
                                                ElementStyle="{StaticResource GridDisplayText}"/>
                            <DataGridTemplateColumn Header="" Width="*" MinWidth="90" CanUserResize="False"
                                                    HeaderStyle="{StaticResource LastColumnHeader}"
                                                    CellStyle="{StaticResource LastColumnCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Leave" Style="{StaticResource DangerButton}"
                                                Width="90" Height="35" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                Command="{Binding DataContext.LeaveInstanceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
            </Grid><!-- /toggled content area -->
        </DockPanel>
    </Grid>
</Window>
