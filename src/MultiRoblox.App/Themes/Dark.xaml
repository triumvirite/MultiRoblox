<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#1E1F22</Color>
    <Color x:Key="SurfaceColor">#2B2D31</Color>
    <Color x:Key="Surface2Color">#35373C</Color>
    <Color x:Key="BorderColor">#3F4147</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="SubtleTextColor">#B7BDC6</Color>
    <Color x:Key="AccentColor">#5865F2</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="OkColor">#3BA55D</Color>
    <Color x:Key="WarnColor">#FAA61A</Color>
    <Color x:Key="DangerColor">#ED4245</Color>

    <SolidColorBrush x:Key="Bg" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2" Color="{DynamicResource Surface2Color}"/>
    <SolidColorBrush x:Key="Border" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="Text" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="SubtleText" Color="{DynamicResource SubtleTextColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentText" Color="{DynamicResource AccentTextColor}"/>
    <SolidColorBrush x:Key="Ok" Color="{DynamicResource OkColor}"/>
    <SolidColorBrush x:Key="Warn" Color="{DynamicResource WarnColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{DynamicResource DangerColor}"/>

</ResourceDictionary>
